{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brreg-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brreg",
      "database_id": "eb0d3f1a-b687-4bf8-93ff-85c0d88eccb5"
    }
  ]
}
